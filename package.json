{
  "name": "skycontrol",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:trace": "playwright test --trace on",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:e2e:ui-less": "bash scripts/e2e.sh",
    "test:e2e:update": "playwright test --grep @visual --update-snapshots"
  },
  "dependencies": {
    "@types/three": "^0.184.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.45.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.12.12",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "puppeteer": "^25.1.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^6.0.3"
  }
}
